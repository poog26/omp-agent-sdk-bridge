{
	"name": "omp-agent-sdk-bridge",
	"version": "0.11.0",
	"private": false,
	"description": "Oh My Pi extension that runs Claude Code (via the official Claude Agent SDK) as an OMP model provider, forwarding OMP's persona, skills and context, with switchable 1M / 200K windows and an AskClaude delegation tool.",
	"keywords": [
		"omp-package",
		"oh-my-pi",
		"extension",
		"claude-code",
		"claude-agent-sdk",
		"context-window",
		"1m-context"
	],
	"author": "poog26 (https://github.com/poog26)",
	"contributors": [
		"Eli Dickinson (original pi-claude-bridge, https://github.com/elidickinson)",
		"Jonathan Borgwing (Oh My Pi port, https://github.com/DevVig)"
	],
	"license": "MIT",
	"homepage": "https://github.com/poog26/omp-agent-sdk-bridge#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/poog26/omp-agent-sdk-bridge.git"
	},
	"bugs": {
		"url": "https://github.com/poog26/omp-agent-sdk-bridge/issues"
	},
	"engines": {
		"node": ">=20"
	},
	"files": [
		"src",
		"README.md",
		"LICENSE",
		"NOTICE",
		"tsconfig.json"
	],
	"scripts": {
		"test": "node --import tsx --test tests/unit-*.mjs",
		"test:unit": "node --import tsx --test tests/unit-*.mjs",
		"test:contract": "node tests/run-contract.mjs",
		"test:live": "bun tests/live-oneshot.ts && bun tests/live-askclaude.ts",
		"typecheck": "tsc --noEmit"
	},
	"type": "module",
	"dependencies": {
		"@anthropic-ai/claude-agent-sdk": "0.3.308",
		"cc-session-io": "^0.4.0",
		"change-case": "^5.4.4",
		"zod": "^4.6.7"
	},
	"peerDependencies": {
		"@oh-my-pi/pi-agent-core": ">=18.15.0",
		"@oh-my-pi/pi-ai": ">=18.15.0",
		"@oh-my-pi/pi-coding-agent": ">=18.15.0",
		"@oh-my-pi/pi-tui": ">=18.15.0",
		"@oh-my-pi/pi-utils": ">=18.15.0"
	},
	"peerDependenciesMeta": {
		"@oh-my-pi/pi-ai": {
			"optional": true
		},
		"@oh-my-pi/pi-agent-core": {
			"optional": true
		},
		"@oh-my-pi/pi-coding-agent": {
			"optional": true
		},
		"@oh-my-pi/pi-tui": {
			"optional": true
		},
		"@oh-my-pi/pi-utils": {
			"optional": true
		}
	},
	"devDependencies": {
		"@anthropic-ai/sdk": "^0.124.0",
		"@oh-my-pi/pi-agent-core": "^18.15.0",
		"@oh-my-pi/pi-ai": "^18.15.0",
		"@oh-my-pi/pi-coding-agent": "^18.15.0",
		"@oh-my-pi/pi-tui": "^18.15.0",
		"@oh-my-pi/pi-utils": "^18.15.0",
		"@types/node": "^24.13.2",
		"tsx": "^4.22.4",
		"typescript": "^6.0.3"
	},
	"trustedDependencies": [
		"esbuild"
	],
	"omp": {
		"extensions": [
			"./src/index.ts"
		]
	}
}
